# App-venster
app.title=Latice

# App-menu's:
# # Startmenu
menu.start.title=Latice
menu.start.play=Spelen
menu.start.rules=Regels

# # Regelsmenu
menu.rules.title=Spelregels
menu.rules.firstCategory=Opstelling
menu.rules.firstCategory.description=De tegels worden geschud en gelijkmatig verdeeld tussen 2 spelers. Elke speler trekt 5 tegels op zijn rek. De eerste speler legt een tegel op het maanvak (midden) om te beginnen.
menu.rules.secondCategory=Jouw beurt
menu.rules.secondCategory.description=De eerste actie is GRATIS. Elke extra actie kost 2 punten. Kies een van de 4 acties hieronder.
menu.rules.secondCategory.list=4 mogelijke acties
menu.rules.secondCategory.list.first=1. Tegel leggen — Leg een tegel van je rek naast een bestaande tegel. Elke aanrakende zijde moet overeenkomen op kleur of vorm.
menu.rules.secondCategory.list.second=2. Actie kopen — Geef 2 punten uit om een extra zet te spelen.
menu.rules.secondCategory.list.third=3. Rek wisselen — Vervang alle tegels op je rek door nieuwe uit je voorraad. Beëindigt je beurt.
menu.rules.secondCategory.list.fourth=4. Passen — Sla je beurt over voor gratis.
menu.rules.thirdCategory=Score
menu.rules.thirdCategory.description=Dubbel (2 gelijke zijden) => +1 pt  |  Klaverblad (3 zijden) => +2 pts  |  Latice (4 zijden) => +4 pts  |  Zonvak => +2 pts bonus
menu.rules.fourthCategory=Einde van het spel
menu.rules.fourthCategory.description=Het spel eindigt wanneer een speler zijn rek en voorraad leegmaakt, of na 10 rondes (1 ronde = 1 beurt per speler). De speler die de meeste tegels heeft gelegd, wint.
menu.rules.back=Terug

