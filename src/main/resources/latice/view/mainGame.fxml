            <Label fx:id="currentPlayerLabel" minWidth="300.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="...'s turn:" translateX="250.0" translateY="90.0" />
            <Label fx:id="currentPlayerScoreLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Score: " translateX="250.0" translateY="120.0" />
               <Label fx:id="playerTileRemainingLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Tile restante:  ..." translateX="250.0" translateY="150.0" />
         </children>
      </VBox>
   </left>
   <right>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" scaleX="3.0" scaleY="3.0" text="End Turn" translateX="-200.0" translateY="800.0" onAction="#buttonEndTurn"/>
         </children>
      </VBox>
   </right>
</BorderPane>
   <StackPane fx:id="screenOverlay" managed="false" prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: rgba(0,0,0,1);" visible="false">
      <children>
         <VBox alignment="CENTER" spacing="30.0">
            <children>
               <Label fx:id="lastPlayerLabel" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" text="Score de ...:" />
               <Label fx:id="lastPlayerScoreLabel" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: white;" text="...">
                  <VBox.margin>
                     <Insets bottom="100.0" />
                  </VBox.margin>
                  <padding>
                     <Insets bottom="100.0" />
                  </padding>
               </Label>
               <Label fx:id="overlayPlayerLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;" text="C'est au tour de : ..." />
               <Button fx:id="overlayButton" mnemonicParsing="false" prefHeight="60.0" prefWidth="300.0" style="-fx-font-size: 22px; -fx-background-radius: 10;" text="I'm ready!" />
            </children>
         </VBox>
      </children>
   </StackPane>
</StackPane>
