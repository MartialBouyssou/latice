      <children>
         <VBox fx:id="playMenuVBox" alignment="CENTER" spacing="30.0">
            <children>
               <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: white;" text="Latice">
                  <padding>
                     <Insets bottom="30.0" />
                  </padding>
                  <VBox.margin>
                     <Insets bottom="30.0" />
                  </VBox.margin>
               </Label>
               <Button mnemonicParsing="false" onAction="#showUsernameChoiceMenu" prefHeight="60.0" prefWidth="300.0" style="-fx-font-size: 22px; -fx-background-radius: 10;" text="Play" />
               <Button mnemonicParsing="false" onAction="#showRules" prefHeight="60.0" prefWidth="300.0" style="-fx-font-size: 22px; -fx-background-radius: 10;" text="Rules" />
            </children>
         </VBox>
         <VBox fx:id="usernameMenuVBox" alignment="CENTER" spacing="30.0" visible="false">
            <children>
               <Label style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: white;" text="Latice">
                  <padding>
                     <Insets bottom="30.0" />
                  </padding>
                  <VBox.margin>
                     <Insets bottom="30.0" />
                  </VBox.margin>
               </Label>
               <Label style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;" text="Player 1 username:" />
               <TextField fx:id="player1UsernameTf" maxHeight="50.0" maxWidth="175.0" minHeight="50.0" minWidth="175.0" prefHeight="50.0" prefWidth="175.0" />
               <Label style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: white;" text="Player 2 username:" />
               <TextField fx:id="player2UsernameTf" maxHeight="50.0" maxWidth="175.0" minHeight="50.0" minWidth="175.0" prefHeight="50.0" prefWidth="175.0" />
               <Button maxHeight="67.0" maxWidth="300.0" minHeight="67.0" minWidth="300.0" mnemonicParsing="false" onAction="#startGame" prefHeight="67.0" prefWidth="300.0" style="-fx-font-size: 32px; -fx-background-radius: 10;" text="Play">
                  <VBox.margin>
                     <Insets top="75.0" />
                  </VBox.margin></Button>
            </children>
         </VBox>
         <VBox fx:id="rulesMenuVBox" alignment="TOP_CENTER" spacing="16.0" style="-fx-padding: 60 200 60 200;" visible="false">
            <children>
               <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="Rules">
                  <padding>
                     <Insets top="75.0" />
                  </padding>
                  <VBox.margin>
                     <Insets top="75.0" />
                  </VBox.margin></Label>

               <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Setup" />
               <Label style="-fx-font-size: 15px; -fx-text-fill: #cccccc;" text="Tiles are shuffled and split equally between 2 players. Each player draws 5 tiles onto their rack. The first player places one tile on the moon square (center) to start." wrapText="true" />

               <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="On your turn" />
               <Label style="-fx-font-size: 15px; -fx-text-fill: #cccccc;" text="The first action is FREE. Each additional action costs 2 points. Choose one of the 4 actions below." wrapText="true" />

               <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="4 possible actions" />
               <Label style="-fx-font-size: 15px; -fx-text-fill: #cccccc;" text="1. Play a tile — Place a tile from your rack adjacent to an existing tile. Each touching side must match by color or shape." wrapText="true" />
               <Label style="-fx-font-size: 15px; -fx-text-fill: #cccccc;" text="2. Buy an action — Spend 2 points to play an extra move." wrapText="true" />
               <Label style="-fx-font-size: 15px; -fx-text-fill: #cccccc;" text="3. Exchange rack — Replace all tiles on your rack with new ones from your pool. Ends your turn." wrapText="true" />
               <Label style="-fx-font-size: 15px; -fx-text-fill: #cccccc;" text="4. Pass — Skip your turn for free." wrapText="true" />

               <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Scoring" />
               <Label style="-fx-font-size: 15px; -fx-text-fill: #cccccc;" text="Double (2 matching sides) → +1 pt  |  Trefoil (3 sides) → +2 pts  |  Latice (4 sides) → +4 pts  |  Sun square → +2 pts bonus" wrapText="true" />

               <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="End of game" />
               <Label style="-fx-font-size: 15px; -fx-text-fill: #cccccc;" text="The game ends when a player empties their rack and pool, or after 10 cycles (1 cycle = 1 turn per player). The player who placed the most tiles wins." wrapText="true" />

               <Button mnemonicParsing="false" onAction="#showPlayMenu" prefHeight="50.0" prefWidth="200.0" style="-fx-font-size: 18px; -fx-background-radius: 10;" text="Back">
                  <VBox.margin>
                     <Insets top="20.0" />
                  </VBox.margin>
               </Button>
            </children>
         </VBox>
      </children>
   </StackPane>
